  "templates": {
    "outreach": {
      "initial": "Subject: Exciting [Role] Opportunity at [Company]\n\nHi [Name],\n\nI came across your profile and was impressed by your experience in [Specific Skill/Achievement]. We're currently looking for a [Role] to join our team at [Company], and I believe your background aligns perfectly with what we're seeking.\n\n[Brief description of role and why it's exciting]\n\nWould you be open to a brief conversation to learn more about this opportunity?\n\nBest regards,\n[Your Name]",
      "followUp": "Subject: Following up on [Role] at [Company]\n\nHi [Name],\n\nI wanted to follow up on my previous message about the [Role] opportunity at [Company]. I understand you're likely busy, but I genuinely believe this could be a great next step in your career because [Specific Reason].\n\nIf you're not interested, I completely understand. However, if you know someone in your network who might be a good fit, I'd appreciate any referrals.\n\nBest regards,\n[Your Name]"
    },
    "screening": {
      "phone": [
        "Tell me about your current role and responsibilities",
        "What interests you about this opportunity?",
        "What are your salary expectations?",
        "What's your availability for next steps?",
        "Do you have any questions about the role or company?"
      ],
      "technical": [
        "Walk me through a recent project you're proud of",
        "How do you approach problem-solving?",
        "What technologies are you most comfortable with?",
        "How do you stay current with industry trends?",
        "Describe a technical challenge you overcame"
      ]
    }
